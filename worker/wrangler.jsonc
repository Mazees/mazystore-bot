{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "mazy-store-api",
  "main": "index.js",
  "compatibility_date": "2026-11-20",
  "workers_dev": true,
  "d1_databases": [{
    "binding": "DB",
    "database_name": "mazy-store",
    "database_id": "REPLACE_WITH_D1_DATABASE_ID",
    "migrations_dir": "migrations"
  }],
  "observability": { "enabled": false }
}
