{
  "name": "mazy-store",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "start": "node --env-file=.env src/index.js",
    "test": "node --test",
    "check": "node scripts/check.js",
    "worker:dev": "wrangler dev --config worker/wrangler.local.jsonc",
    "worker:deploy": "wrangler deploy --config worker/wrangler.local.jsonc",
    "db:local": "wrangler d1 migrations apply mazy-store --local --config worker/wrangler.local.jsonc",
    "db:remote": "wrangler d1 migrations apply mazy-store --remote --config worker/wrangler.local.jsonc",
    "qris:import": "node scripts/import-qris.js",
    "setup": "node scripts/setup.js",
    "backup": "node --env-file=.env scripts/backup.js",
    "worker:secret": "node --env-file=.env scripts/worker-secret.js"
  },
  "dependencies": {
    "baileys": "7.0.0-rc14",
    "express": "5.3.0",
    "jsqr": "1.4.0",
    "pino": "10.4.0",
    "qrcode": "1.5.4",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "miniflare": "5.20261118.0-beta",
    "wrangler": "4.165.0"
  }
}
